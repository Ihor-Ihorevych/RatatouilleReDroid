<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.ratatouille">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
    <!-- Vulkan 1.3 for the renderer; devices below it are skipped at run time with a log line -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.gamepad" android:required="false"/>
    <!-- the settings panel opens links (Telegram, GitHub): Android 11 and later only lets an app see who can open them if it asks -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
    <application android:label="Ratatouille" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:isGame="true" android:hasCode="true"
        android:extractNativeLibs="true" android:allowBackup="false" android:debuggable="true">
        <!-- the launcher: unpacks the game of a selfpack APK on the first start, then opens the game -->
        <activity android:name="io.github.ratatouille.SetupActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="io.github.ratatouille.GameActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density|smallestScreenSize"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"/>
    </application>
</manifest>
